# =============================================================================
# mtls-pkcs12-agent. Copy to ".env" and fill in. NEVER commit the .env files.
# The tests and the CLI demo need none of these: they run on generated fixtures.
# =============================================================================

# Base64 of the PKCS#12 file. The first-class path, because a host with no persistent
# filesystem has nowhere to put the file — and because a key written to disk to satisfy a
# path-only API survives a crash and lands in a container layer.
#   base64 -w0 client.p12
MTLS_PKCS12_BASE64=

# Path to the PKCS#12 file. Read only when the base64 variable is empty, so a deployed
# value always wins over a developer's leftover.
MTLS_PKCS12_PATH=

# The passphrase, if the file has one. Some issuers export without.
MTLS_PKCS12_PASSPHRASE=
